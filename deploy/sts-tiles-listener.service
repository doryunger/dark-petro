[Unit]
Description=STS viewer: rebuild tiles when S3 publishes findings (SQS long poll)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f sts-tiles-listener
ExecStart=/usr/bin/docker run --rm --name sts-tiles-listener --user 1000:1000 --memory 400m --env-file @APP_DIR@/.env -v @APP_DIR@/data:/data sts-tiles listen
ExecStop=/usr/bin/docker stop --time 30 sts-tiles-listener
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
