HOST=user@server-address
KEY=/path/to/ssh-key.pem
STS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
CREDENTIALS_SOURCE=/path/on/server/to/an/env/file/with/the/AWS/keys
VIEWER_PORT=port-for-the-viewer-on-the-server-loopback
MAPBOX_ACCESS_TOKEN=public-token-that-starts-with-pk
