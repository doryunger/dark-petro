[Unit]
Description=STS viewer: serve the filtered tiles, the metadata, the captures and the app
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f sts-viewer
ExecStart=/usr/bin/docker run --rm --name sts-viewer --user 1000:1000 --memory 320m --read-only --tmpfs /tmp -e HOME=/tmp -e STS_PORT=8080 -p 127.0.0.1:@PORT@:8080 -v @APP_DIR@/data:/data:ro -v @APP_DIR@/app:/app/dist:ro sts-tiles serve
ExecStop=/usr/bin/docker stop --time 10 sts-viewer
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
